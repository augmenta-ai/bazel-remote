#!/bin/bash
# Check the amd64 image that `bazel run //:bazel-remote-image-tarball` loaded,
# then push it to our ECR as agmt1-<short sha> and print its digest.
# Run it from a clean checkout of the commit the image was built from. IMAGE
# overrides the image to push. With --dry-run, it runs every check and does
# not push.
set -euo pipefail

script_dir=$(dirname "${BASH_SOURCE[0]}")
cd "${script_dir}/.."

image=${IMAGE:-buchgr/bazel-remote-cache:tmp-amd64}
registry=650765441893.dkr.ecr.us-east-2.amazonaws.com
repository=buchgr/bazel-remote-cache
dry_run=false
case "$*" in
	"") ;;
	--dry-run) dry_run=true ;;
	*) echo "Usage: $0 [--dry-run]" >&2; exit 2 ;;
esac

fail() { echo "Error: $*" >&2; exit 1; }
# version_ge A B: true when version A >= version B.
version_ge() { [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" = "$2" ]; }

[ -z "$(git status --porcelain)" ] || fail "the tree is not clean"
commit=$(git rev-parse HEAD)
tag=agmt1-$(git rev-parse --short=7 HEAD)
go_version=$(sed -n 's/^go_sdk.download(version = "\(.*\)")$/\1/p' MODULE.bazel)
[ -n "$go_version" ] || fail "no go_sdk.download() version in MODULE.bazel"

# The image must come from this commit and Go version, support cgo zstd,
# and carry neither compromised eMudhra root.
docker run --rm "$image" --max_size=1 --idle_timeout=1s 2>&1 |
	grep -F "built with go${go_version} from git commit ${commit}" ||
	fail "$image was not built with go${go_version} from ${commit}"
docker run --rm "$image" -h | grep zstd_implementation | grep -q '"cgo"' ||
	fail "$image does not support cgo zstd"
bundle=$(mktemp)
container=
cleanup() {
	rm -f "$bundle"
	[ -z "$container" ] || docker rm -f "$container" >/dev/null
}
trap cleanup EXIT
container=$(docker create "$image")
docker cp -L "$container:/etc/ssl/certs/ca-certificates.crt" "$bundle" >/dev/null
subjects=$(openssl crl2pkcs7 -nocrl -certfile "$bundle" | openssl pkcs7 -print_certs -noout)
[ -n "$subjects" ] || fail "the CA bundle in $image is empty"
for root in 'emSign ECC Root CA - G3' 'AAA Certificate Services'; do
	! grep -qF "$root" <<<"$subjects" || fail "the CA bundle still holds $root"
done
echo "$image passed its checks"

# Older releases of both tools trust the compromised chains, and both send
# the ECR credential.
engine=$(docker version --format '{{.Server.Version}}')
aws_cli=$(aws --version | sed 's#^aws-cli/\([^ ]*\).*#\1#')
version_ge "$engine" 29.9.2 || fail "Docker Engine $engine is older than 29.9.2"
version_ge "$aws_cli" 2.38.4 || fail "AWS CLI $aws_cli is older than 2.38.4"

if $dry_run; then
	echo "Dry run: would push $image as $registry/$repository:$tag"
	exit 0
fi
docker tag "$image" "$registry/$repository:$tag"
aws ecr get-login-password --region us-east-2 |
	docker login --username AWS --password-stdin "$registry"
docker push "$registry/$repository:$tag"
aws ecr describe-images --region us-east-2 --repository-name "$repository" \
	--image-ids imageTag="$tag" --query 'imageDetails[0].imageDigest' --output text
